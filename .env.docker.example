# ==============================================================================
# BWS LIS - DOCKER COMPOSE ENVIRONMENT OVERRIDES
# ==============================================================================
# Salin file ini menjadi .env di root jika ingin mengubah port atau kredensial default:
# cp .env.docker.example .env

# Database Kredensial
DB_DATABASE=bws_lis_db
DB_USERNAME=bws_admin
DB_PASSWORD=bws_secret_pass

# Laravel App Key (Default telah diisi key valid)
APP_KEY=base64:BcVxVCmEIe2YRxRFvRLjrkM7yngaeQQKEhxe5nzoe+g=

# Host Port Mapping (Dev Mode)
DOCKER_PGSQL_PORT=5432
DOCKER_BE_PORT=8000
DOCKER_FE_PORT=5173
DOCKER_PWA_PORT=5174

# Host Port Mapping (Prod Mode)
DOCKER_FE_PROD_PORT=8080
DOCKER_PWA_PROD_PORT=8081

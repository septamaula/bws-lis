# ==============================================================================
# BWS LEARNING INTEGRATED SYSTEM (LIS) - ROOT GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
vendor/
*/node_modules/
*/vendor/
.pnpm-store/

# ------------------------------------------------------------------------------
# Environment, Credentials & Local Configs (Keep .env.example)
# ------------------------------------------------------------------------------
.env
.env.backup
.env.production
.env.local
.env.*.local
*.key
auth.json
Homestead.json
Homestead.yaml

# ------------------------------------------------------------------------------
# Build Artifacts & Compiled Distribution Outputs
# ------------------------------------------------------------------------------
dist/
build/
*/dist/
*/build/
/be/public/build/
/be/public/hot
/be/public/storage
dist-ssr/
*.local

# ------------------------------------------------------------------------------
# Laravel Runtime, Framework Caches & Logs (be/)
# ------------------------------------------------------------------------------
/be/storage/*.key
/be/storage/logs/*
!/be/storage/logs/.gitignore
/be/storage/framework/cache/data/*
!/be/storage/framework/cache/data/.gitignore
/be/storage/framework/cache/locks/*
!/be/storage/framework/cache/locks/.gitignore
/be/storage/framework/sessions/*
!/be/storage/framework/sessions/.gitignore
/be/storage/framework/views/*
!/be/storage/framework/views/.gitignore
/be/storage/framework/testing/*
!/be/storage/framework/testing/.gitignore
/be/bootstrap/cache/*
!/be/bootstrap/cache/.gitignore
/be/storage/pail
.phpunit.result.cache
.phpunit.cache/
_ide_helper.php
.phpactor.json

# ------------------------------------------------------------------------------
# IDE & Editor Specific Directories
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
.nova/
.zed/
.codex/
.cursor/

# ------------------------------------------------------------------------------
# OS Junk & Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
*.temp
*.swp
*~

# ------------------------------------------------------------------------------
# Logs & Process Dumps
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

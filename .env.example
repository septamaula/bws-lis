# ==============================================================================
# BWS LIS - DOCKER COMPOSE ROOT ENVIRONMENT
# ==============================================================================

# Database Credentials for Docker Database Container
DB_DATABASE=bws_lis_db
DB_USERNAME=bws_admin
DB_PASSWORD=bws_secret_pass
MYSQL_ROOT_PASSWORD=bws_root_pass

# Laravel App Key
APP_KEY=base64:BcVxVCmEIe2YRxRFvRLjrkM7yngaeQQKEhxe5nzoe+g=

# Host Port Mapping
# Port 3307 untuk MySQL (menghindari port 3306 Laragon lokal)
DOCKER_MYSQL_PORT=3307
# Port 5433 untuk PostgreSQL
DOCKER_PGSQL_PORT=5433
# Port 8001 untuk Backend API (menghindari port 8000 yang dipakai geofit di Docker)
DOCKER_BE_PORT=8001
# Port 5173 untuk Portal Admin & Operasional (Vue 3)
DOCKER_FE_PORT=5173
# Port 5174 untuk Portal Belajar Karyawan (React Mobile PWA)
DOCKER_PWA_PORT=5174
